# Local throwaway database. Copy to server/.env. Never commit server/.env.
DATABASE_URL=postgres://cinema:cinema@127.0.0.1:5432/cinema

# HTTP port. Defaults to 3000.
PORT=3000

# Browser origin allowed to call the API. Comma-separated for more than one.
# No cookies are used.
CORS_ORIGIN=http://localhost:5173

# Calendar date for GET /api/shows?date=YYYY-MM-DD. IANA zone name.
CINEMA_TZ=Europe/Berlin

# Hold length in seconds. Positive integer. Clients read holdExpiresAt.
HOLD_SECONDS=600
